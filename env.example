# Aikun Configuration
# 环境变量需带 AIKUN_ 前缀;同名命令行参数(--host 等)也可使用,
# 优先级: AIKUN_* 环境变量 > 命令行参数 > 默认值。
# 注意:以下 AIKUN_HOST / AIKUN_DATABASE_URL 是本地开发值;
# docker compose 部署时由 compose 文件强制覆盖为容器内值,无需修改。
AIKUN_HOST=127.0.0.1:3000
# 渠道上游 key 的静态加密密钥缺省由此派生:未设置 AIKUN_ENCRYPTION_KEY 时
# 不要更换本值,否则已加密的渠道 key 将无法解密(JWT 也会同时失效)。
AIKUN_JWT_SECRET=change-this-to-a-very-long-random-secret-key
# 独立的渠道 key 静态加密密钥:固定它之后即可自由轮换 JWT secret。
# AIKUN_ENCRYPTION_KEY=another-long-random-secret-key
# 运维逃生口:设置后启动即重置 admin 密码并踢掉全部旧会话(密码不打印到
# 日志);用完后请立即移除该变量再重启。
# AIKUN_RESET_ADMIN_PASSWORD=
AIKUN_JWT_EXPIRES_IN=604800
AIKUN_DATABASE_URL=sqlite://aikun.db?mode=rwc
AIKUN_HEALTH_CHECK_INTERVAL=30
AIKUN_MAX_RETRIES=3
AIKUN_AUTO_DISABLE_THRESHOLD=5
AIKUN_REQUEST_TIMEOUT_SECS=120
AIKUN_LOG_RETENTION_DAYS=30
# AIKUN_CORS_ALLOWED_ORIGINS=https://example.com,https://app.example.com
# AIKUN_TRUST_X_FORWARDED_FOR=1
# 日志级别(tracing EnvFilter,注意没有 AIKUN_ 前缀),默认 aikun=info,tower_http=info
# RUST_LOG=aikun=debug
