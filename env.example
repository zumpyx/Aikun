# Aikun Configuration
# 环境变量需带 AIKUN_ 前缀;同名命令行参数(--host 等)也可使用,
# 优先级: AIKUN_* 环境变量 > 命令行参数 > 默认值。
# 注意:以下 AIKUN_HOST / AIKUN_SURREAL_URL 是本地开发值;
# docker compose 部署时由 compose 文件强制覆盖为容器内值,无需修改。
AIKUN_HOST=127.0.0.1:3000
# 渠道上游 key 的静态加密密钥缺省由此派生:未设置 AIKUN_ENCRYPTION_KEY 时
# 不要更换本值,否则已加密的渠道 key 将无法解密(JWT 也会同时失效)。
AIKUN_JWT_SECRET=change-this-to-a-very-long-random-secret-key
# 独立的渠道 key 静态加密密钥:固定它之后即可自由轮换 JWT secret。
# AIKUN_ENCRYPTION_KEY=another-long-random-secret-key
# 运维逃生口:设置后启动即重置 admin 密码并踢掉全部旧会话(密码不打印到
# 日志);用完后请立即移除该变量再重启。
# AIKUN_RESET_ADMIN_PASSWORD=
AIKUN_JWT_EXPIRES_IN=604800
# 数据库端点(SurrealDB)。未设置 = 嵌入式 SurrealKV,数据目录默认
# ./data/aikun.surreal(旧部署的 ./aikun.surreal 自动沿用)。形式:
# surrealkv://<目录> | mem://(测试)| ws://host:8000 | wss://host |
# http://host:8000 | https://host,可带 ?ns=&db=&user=&pass=
# (ns/db 默认 aikun/aikun;user/pass 仅远程,root 登录)。
# 容器部署用:surrealkv:///data/aikun.surreal(数据落 /data 卷)。
# 两个变量名等价(任选其一,AIKUN_SURREAL_URL 优先):数据库连接一个名字就够。
AIKUN_DATABASE_URL=surrealkv://./data/aikun.surreal
# AIKUN_SURREAL_URL=surrealkv://./data/aikun.surreal
# 仅旧 SQLite 部署:sqlite:// 开头的值 = 旧库位置——迁移工具 aikun-migrate
# 读取它作源库;未显式配置 Surreal 端点时,主程序把嵌入式 SurrealKV 目录
# 随迁到旧库同目录(防升级后数据落点漂移)。升级:先停旧服务,执行
#   AIKUN_DATABASE_URL=sqlite:///data/aikun.db aikun-migrate
# 完成后按上行把本变量改回 SurrealDB 端点启动即可(幂等可重跑)。
# AIKUN_DATABASE_URL=sqlite:///data/aikun.db
AIKUN_HEALTH_CHECK_INTERVAL=30
AIKUN_MAX_RETRIES=3
AIKUN_AUTO_DISABLE_THRESHOLD=5
AIKUN_REQUEST_TIMEOUT_SECS=120
# 三类独立超时(阶段 2):连接 / 流式首字节 / 流式 chunk 间空闲。
# 非法值(非数字、低于下限)拒绝启动,不静默回退默认值。
# 上游 TCP/TLS 连接超时(秒,≥1;原 15s 硬编码改为可配)
# AIKUN_CONNECT_TIMEOUT_SECS=15
# 流式请求等上游响应头的首字节超时(秒,≥1;原借用渠道超时 clamp 1..60)
# AIKUN_TTFB_TIMEOUT_SECS=60
# 流式 chunk 间空闲超时(秒;0 = 沿用渠道级 timeout_secs,回退
# AIKUN_REQUEST_TIMEOUT_SECS——旧行为;>0 为全局覆盖,clamp 1..600)
# AIKUN_IDLE_TIMEOUT_SECS=0
AIKUN_LOG_RETENTION_DAYS=30
# AIKUN_CORS_ALLOWED_ORIGINS=https://example.com,https://app.example.com
# AIKUN_TRUST_X_FORWARDED_FOR=1
# 日志级别(tracing EnvFilter,注意没有 AIKUN_ 前缀),默认 aikun=info,tower_http=info
# RUST_LOG=aikun=debug

# ---- 响应缓存(默认关闭)----
# off(默认)/ deterministic(仅缓存 temperature=0 的非流式请求)/ always
# AIKUN_CACHE_MODE=off
# 进程内内存缓存(单二进制、零外部依赖)
# AIKUN_CACHE_TTL_SECS=300
# AIKUN_CACHE_MAX_ENTRIES=10000
# AIKUN_CACHE_MAX_ENTRY_BYTES=1048576
# user(默认,按 API key 隔离——JWT 会话按用户)/ global(全站共享)。
# 注意:global 作用域下**所有用户共享缓存**,A 用户的响应会被 B 用户命中
# (串缓存),仅适用于单租户部署;多租户环境开启属已知风险。
# 带 tools 或图片(多模态)的请求默认不入缓存。
# AIKUN_CACHE_SCOPE=user
# full(默认,命中照常计费)/ free(命中不扣费)
# AIKUN_CACHE_HIT_BILLING=full
