# ============================================================
# Aikun 配置模板 — 复制为 .env 后按需修改
# ============================================================
# 优先级:AIKUN_* 环境变量 > 命令行参数(--host 等)> 默认值。
# docker compose 部署时由 compose 文件强制覆盖容器内值,无需改这里。

# ---- 基础 ----
# 监听地址(IP:端口)
AIKUN_HOST=127.0.0.1:3000

# JWT 签发密钥(≥32 字符;openssl rand -hex 32)。未单独设
# AIKUN_ENCRYPTION_KEY 时,渠道 key 静态加密密钥也由此派生——
# 存量部署不要更换,否则已加密的渠道 key 解不开、登录态全失效。
AIKUN_JWT_SECRET=change-this-to-a-very-long-random-secret-key
# 独立的渠道 key 静态加密密钥:固定它之后即可自由轮换 JWT secret。
# AIKUN_ENCRYPTION_KEY=another-long-random-secret-key
# JWT 有效期(秒,默认 7 天)
# AIKUN_JWT_EXPIRES_IN=604800
# 运维逃生口:设置后启动即重置 admin 密码并踢掉全部旧会话;
# 用完立即移除再重启。
# AIKUN_RESET_ADMIN_PASSWORD=

# ---- 数据库(速度优先:仅快照模式) ----
# 默认 `surrealkv://./data/data?sync=60s`:嵌入式 SurrealKV **仅快照模式**
# ——提交不 fsync(写路径全速),后台每 60 秒落盘一次;正常停止
# (Ctrl-C/SIGTERM)关库前会把缓冲写入全部落盘,**不丢任何数据**;
# 只有崩溃/断电才可能丢最近一分钟内的写入(调用日志/用量明细级,
# 渠道与反代凭证靠优雅关闭保全)。
# 落盘节奏可调:?sync=every(每次提交 fsync,最稳最慢)/ ?sync=never
# (交给 OS)/ ?sync=5m 等;去掉 ?sync 等于 every。
# 纯内存 `mem://` 最快但**重启丢全部数据**(适合纯测试/缓存场景)。
# 远程 SurrealDB:ws://host:8000?ns=xx&db=xx&user=xx&pass=xx
# sqlite:// 旧值 = 迁移工具源库位置语义(随迁),不作为运行库。
AIKUN_DATABASE_URL=surrealkv://./data/data?sync=60s

# ---- 上游请求 ----
# AIKUN_REQUEST_TIMEOUT_SECS=120
# AIKUN_CONNECT_TIMEOUT_SECS=15
# AIKUN_TTFB_TIMEOUT_SECS=60      # 流式首字节超时
# AIKUN_MAX_RETRIES=3             # 单渠道内重试
# AIKUN_IDLE_TIMEOUT_SECS=300     # SSE 空闲超时

# ---- 渠道健康 / 熔断 ----
# AIKUN_HEALTH_CHECK_INTERVAL=30  # 秒
# AIKUN_AUTO_DISABLE_THRESHOLD=5  # 连续失败自动禁用阈值
# AIKUN_BREAKER_FAILURE_THRESHOLD=3
# AIKUN_BREAKER_COOLDOWN_SECS=30

# ---- 日志 / 运维 ----
# AIKUN_LOG_RETENTION_DAYS=30
# AIKUN_CORS_ALLOWED_ORIGINS=https://example.com
# AIKUN_TRUST_X_FORWARDED_FOR=1
# 日志级别(tracing EnvFilter,无 AIKUN_ 前缀)
# RUST_LOG=aikun=info,tower_http=info

# ---- 响应缓存(默认关闭;开启可提速重复请求) ----
# off(默认)/ deterministic(仅 temperature=0 非流式)/ always
# AIKUN_CACHE_MODE=off
# AIKUN_CACHE_TTL_SECS=300
# AIKUN_CACHE_MAX_ENTRIES=10000
# AIKUN_CACHE_MAX_ENTRY_BYTES=1048576
# user(默认,按用户隔离)/ global(全站共享)
# AIKUN_CACHE_SCOPE=user
# full(默认,命中照常计费)/ free(命中不扣费)
# AIKUN_CACHE_HIT_BILLING=full

# ---- ZCode(反代应用) ----
# OAuth 在线登录端点(国际/国内同一端点;测试可指 mock)
# AIKUN_ZCODE_OAUTH_BASE=https://zcode.z.ai/api/v1
# 每日自动领取闲时额度(默认开;北京时间整点后 10 分执行,幂等)
# AIKUN_ZCODE_AUTO_CLAIM=true
# AIKUN_ZCODE_CLAIM_HOUR=7        # 默认早 7 点(领当晚窗口额度)
